<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Cantina.Spikes.YargSetlist</AssemblyName>
    <RootNamespace>Cantina.Spikes.YargSetlist</RootNamespace>
  </PropertyGroup>

  <!-- The wire parser is the shared Cantina.YargSession project, so the harness, the
       spikes, and the server parse with one implementation that cannot drift from the
       contract in docs/yarg-interface.md (D-012 records why drift is dangerous). -->
  <ItemGroup>
    <ProjectReference Include="../../src/Cantina.YargSession/Cantina.YargSession.csproj" />
  </ItemGroup>

</Project>
