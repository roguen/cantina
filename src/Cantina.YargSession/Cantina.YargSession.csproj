<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The dependency-light YARG session library architecture.md called for: the wire parser,
    the currentSong.json reader, and the state tracker that turns both into the live-state
    promise of docs/live-state.md. No I/O, no ASP.NET, no Barkeep dependency - the spikes
    and the server reference this one copy so neither can drift from the contract.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cantina.YargSession</AssemblyName>
    <RootNamespace>Cantina.YargSession</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
